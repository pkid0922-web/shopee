# 複製這個檔案為 .env 後填入實際值（.env 不會被 git 追蹤）

SECRET_KEY=change-me-to-a-random-string

# 本機開發可以不設，會自動退回本機 SQLite (instance/dev.db)
# 部署到 Railway 時，Railway 的 PostgreSQL plugin 會自動注入 DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/shopee_erp

# 建立管理員帳號用（跑 scripts/seed.py 時套用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
